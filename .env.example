# -----------------------------------------------------------------------------
# ConnectSphere environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Every variable the app reads is documented here — if you add one, add it here.
# -----------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
#
# Prisma needs TWO connection strings when running against Supabase, because
# the app talks to a connection pooler but migrations must talk to Postgres
# directly (see docs/adr/0003 and the Supabase trap in CONTRIBUTING.md).
#
# LOCAL (Docker Compose): both point at the same local Postgres. The pooler
# flags are harmless locally, so we keep DATABASE_URL identical in shape to
# production to avoid surprises.
DATABASE_URL="postgresql://connectsphere:connectsphere@localhost:5432/connectsphere?schema=public"
DIRECT_URL="postgresql://connectsphere:connectsphere@localhost:5432/connectsphere?schema=public"

# PRODUCTION (Supabase) — for reference, do not commit real values:
#   DATABASE_URL = pooled connection, port 6543, pgbouncer enabled
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = direct connection, port 5432, used only for migrations
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth.js (NextAuth v5) -------------------------------------------------
#
# Secret used to sign the session JWT. Generate one with: npx auth secret
# (or: openssl rand -base64 32). Required in every environment.
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Base URL of the app. Auth.js infers this on Vercel, but set it explicitly
# for local dev and CI so callback URLs are stable.
AUTH_URL="http://localhost:3000"

# Trust the host header. Needed on Vercel / behind a proxy. Safe to keep true
# for local dev and CI.
AUTH_TRUST_HOST="true"
