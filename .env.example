# -----------------------------------------------------------------------------
# ConnectSphere environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Every variable the app reads is documented here — if you add one, add it here.
# -----------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
#
# LIVE (Supabase project "connectsphere", ref cczgpvrwmgirvryqecpb, Singapore).
# Get the database password from the team lead or the Supabase dashboard
# (Project Settings → Database → Reset database password), then replace
# <PASSWORD> in both URLs.
#
# BOTH URLs use the SESSION pooler (port 5432). Do NOT use:
#   - the "direct" host db.<ref>.supabase.co — it is IPv6-ONLY, and most
#     home/campus networks cannot route IPv6 (it fails as a bare timeout);
#   - port 6543 (transaction mode) — it breaks the prepared statements the pg
#     driver adapter relies on.
DATABASE_URL="postgresql://postgres.cczgpvrwmgirvryqecpb:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.cczgpvrwmgirvryqecpb:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# LOCAL OFFLINE FALLBACK (Docker Compose) — swap both URLs to these, then
# `docker compose up -d && npm run db:reset` for a local seeded copy:
# DATABASE_URL="postgresql://connectsphere:connectsphere@localhost:5432/connectsphere?schema=public"
# DIRECT_URL="postgresql://connectsphere:connectsphere@localhost:5432/connectsphere?schema=public"

# --- Auth.js (NextAuth v5) -------------------------------------------------
#
# Secret used to sign the session JWT. Generate one with: npx auth secret
# (or: openssl rand -base64 32). Required in every environment.
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Base URL of the app. Auth.js infers this on Vercel, but set it explicitly
# for local dev and CI so callback URLs are stable.
AUTH_URL="http://localhost:3000"

# Trust the host header. Needed on Vercel / behind a proxy. Safe to keep true
# for local dev and CI.
AUTH_TRUST_HOST="true"
